# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never expose

# The address people use to reach the portal (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://portal.classtix.org

# Resend → API Keys. Leave blank to queue emails without sending (they still show in the Email log).
RESEND_API_KEY=
EMAIL_FROM=ClassTix <hello@classtix.org>
EMAIL_REPLY_TO=hello@classtix.org

# Any long random string. Vercel sends it to /api/cron automatically when set as CRON_SECRET.
CRON_SECRET=change-me-to-a-long-random-string
